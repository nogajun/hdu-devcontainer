{
	"folders": [
		{
			// ワークスペースフォルダー
			"name": "workspace",
			"path": "."
		}
	],
	"settings": {
		// github copilotを無効にする
		"chat.disableAIFeatures": true,
		// jinja2でもemmetを使えるようにする
		"emmet.includeLanguages": {
			//  "jinja2": "html",
			"jinja-html": "html"
		},
		// emmetのHTMLを日本語に設定
		"emmet.variables": {
			"lang": "ja"
		},
		// ディレクトリパスを展開
		"explorer.compactFolders": false,
		// おすすめ拡張機能を表示しない
		// "extensions.ignoreRecommendations": true,
		// ターミナルのフォントサイズ
		"terminal.integrated.fontSize": 18,
		// ターミナルで出力が見えなくなるスティッキースクロールを無効にする
		"terminal.integrated.stickyScroll.enabled": false,
		// ターミナルでVS Codeがコマンド補完することを無効にする
		"terminal.integrated.suggest.enabled": false,
		// Windows PowerShell向け設定 https://zenn.dev/nekocodex/articles/eb3403961ad9b966ff6e
		"terminal.integrated.env.windows": {
			"PSExecutionPolicyPreference": "RemoteSigned"
		},
		// アイコンテーマはmaterial icon
		"workbench.iconTheme": "material-icon-theme",
	}
}
